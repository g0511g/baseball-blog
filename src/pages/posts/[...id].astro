---
import { getCollection, render } from 'astro:content';
import 'katex/dist/katex.min.css';
import Base from '../../layouts/Base.astro';
import { CATEGORIES, url, formatDate } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const cat = CATEGORIES[post.data.category];
const toc = headings.filter((h) => h.depth === 2);
---

<Base title={post.data.title} description={post.data.description} active={post.data.category}>
  <article class="post">
    <header class="post-head">
      <a class="chip" href={url(`/category/${post.data.category}/`)}>{cat.code} · {cat.name}</a>
      <h1>{post.data.title}</h1>
      <p class="lead">{post.data.description}</p>
      <div class="meta">
        <span class="label">{formatDate(post.data.date)}</span>
        <span class="tag">{post.data.tags.map((t) => `#${t}`).join(' ')}</span>
      </div>
    </header>

    {
      post.data.highlights.length > 0 && (
        <div class="tiles highlights">
          {post.data.highlights.map((h) => (
            <div class="panel tile">
              <span class="label">{h.label}</span>
              <div class="value">{h.value}</div>
              {h.note && <div class="note">{h.note}</div>}
            </div>
          ))}
        </div>
      )
    }

    <div class="body">
      {
        toc.length > 0 && (
          <aside class="toc">
            <div class="panel">
              <span class="label">Contents</span>
              <ol>
                {toc.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </div>
          </aside>
        )
      }
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</Base>

<style>
  .post-head { padding: 56px 0 24px; max-width: 820px; }
  .post-head h1 { font-size: clamp(28px, 4vw, 40px); line-height: 1.3; margin: 14px 0 10px; letter-spacing: -0.02em; }
  .lead { color: var(--muted); font-size: 17px; margin: 0 0 16px; }
  .meta { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }
  .highlights { margin-bottom: 40px; }

  .body { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 40px; align-items: start; }
  .toc { position: sticky; top: 80px; }
  .toc .panel { padding: 16px; }
  .toc ol { margin: 10px 0 0; padding-left: 18px; font-size: 13px; color: var(--muted); }
  .toc li { margin: 6px 0; }
  .toc a:hover { color: var(--accent); }

  .prose { max-width: 760px; font-size: 16.5px; }
  .prose :global(h2) {
    font-size: 24px; margin: 48px 0 16px; padding-top: 12px; border-top: 1px solid var(--line); scroll-margin-top: 80px;
  }
  .prose :global(h2:first-child) { margin-top: 0; border-top: 0; padding-top: 0; }
  .prose :global(h3) { font-size: 19px; margin: 32px 0 10px; color: var(--accent); scroll-margin-top: 80px; }
  .prose :global(p), .prose :global(li) { color: #cfd6e6; }
  .prose :global(a) { color: var(--accent); border-bottom: 1px solid rgba(61, 220, 151, 0.4); }
  .prose :global(strong) { color: var(--text); }
  .prose :global(code) { font-family: var(--mono); font-size: 0.9em; background: var(--panel-2); padding: 1px 6px; border-radius: 5px; }
  .prose :global(blockquote) {
    margin: 20px 0; padding: 14px 18px; background: var(--panel); border: 1px solid var(--line);
    border-left: 3px solid var(--warn); border-radius: 8px; color: var(--muted);
  }
  .prose :global(blockquote p) { margin: 0; }
  .prose :global(table) {
    width: 100%; border-collapse: collapse; margin: 20px 0; font-size: 14px;
    background: var(--panel); border: 1px solid var(--line); border-radius: 10px; overflow: hidden; display: block; overflow-x: auto;
  }
  .prose :global(th) { text-align: left; font-family: var(--mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); background: var(--panel-2); }
  .prose :global(th), .prose :global(td) { padding: 10px 14px; border-bottom: 1px solid var(--line); white-space: nowrap; }
  .prose :global(td) { font-variant-numeric: tabular-nums; }
  .prose :global(.katex-display) {
    background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 16px 12px; overflow-x: auto; overflow-y: hidden;
  }
  .prose :global(.katex) { color: var(--text); }

  @media (max-width: 900px) {
    .body { grid-template-columns: 1fr; }
    .toc { position: static; }
  }
</style>
