---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { CATEGORIES, type CategoryId } from '../../data/site';

export function getStaticPaths() {
  return Object.keys(CATEGORIES).map((id) => ({ params: { id } }));
}

const id = Astro.params.id as CategoryId;
const cat = CATEGORIES[id];
const posts = (await getCollection('posts', ({ data }) => !data.draft && data.category === id)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title={cat.name} description={cat.description} active={id}>
  <section class="head">
    <span class="label">// Category · {cat.code}</span>
    <h1>{cat.name}</h1>
    <p>{cat.description}</p>
    <span class="chip">{posts.length} POSTS</span>
  </section>

  {
    posts.length > 0 ? (
      <div class="grid">{posts.map((post) => <PostCard post={post} />)}</div>
    ) : (
      <div class="panel empty">이 카테고리의 첫 글을 준비하고 있어요.</div>
    )
  }
</Base>

<style>
  .head { padding: 56px 0 28px; }
  .head h1 { font-size: 36px; margin: 8px 0; }
  .head p { color: var(--muted); margin: 0 0 16px; }
</style>
