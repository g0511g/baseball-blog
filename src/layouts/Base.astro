---
import '../styles/global.css';
import { SITE, CATEGORIES, url } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  active?: string;
}
const { title, description = SITE.description, active = '' } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap" />
  </head>
  <body>
    <header class="topbar">
      <div class="wrap">
        <a class="brand" href={url('/')}><span class="brand-dot"></span>{SITE.name}</a>
        <nav class="nav">
          <a href={url('/')} class={active === 'home' ? 'active' : ''}>홈</a>
          {
            Object.entries(CATEGORIES).map(([id, c]) => (
              <a href={url(`/category/${id}/`)} class={active === id ? 'active' : ''}>
                {c.name}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} {SITE.name}</span>
        <span>{SITE.tagline}</span>
      </div>
    </footer>
  </body>
</html>
